[debug] [2025-11-26T03:47:01.012Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/medicareapp-f0dc0:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    // Helper functions for common checks\r\n    function isSignedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    // Safely get the user's role, returning an empty string if not found or no role field.\r\n    function getUserRole() {\r\n      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));\r\n      return (userDoc.data != null && 'role' in userDoc.data) ? userDoc.data.role : '';\r\n    }\r\n\r\n    function isAdmin() {\r\n      return isSignedIn() && getUserRole() == 'admin';\r\n    }\r\n\r\n    function isDoctor() {\r\n      return isSignedIn() && getUserRole() == 'doctor';\r\n    }\r\n\r\n    function isPatient() {\r\n      return isSignedIn() && getUserRole() == 'patient';\r\n    }\r\n\r\n    function isOwner(userId) {\r\n      return isSignedIn() && request.auth.uid == userId;\r\n    }\r\n\r\n    function isAppointmentParticipant(appointmentData) {\r\n      // Safely get the user document first\r\n      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));\r\n      \r\n      // Proceed only if the user document exists\r\n      return isSignedIn() && userDoc.data != null && (\r\n        userDoc.data.get('doctorCode', '') == appointmentData.doctorId ||\r\n        userDoc.data.get('code', '') == appointmentData.code ||\r\n        request.auth.uid == appointmentData.patientId ||\r\n        request.auth.uid == appointmentData.doctorId\r\n      );\r\n    }\r\n\r\n    function isConversationParticipant(conversationData) {\r\n      return isSignedIn() && conversationData != null && (\r\n        ('patientId' in conversationData && request.auth.uid == conversationData.patientId) ||\r\n        ('doctorId' in conversationData && request.auth.uid == conversationData.doctorId) ||\r\n        ('participants' in conversationData && conversationData.participants is list && conversationData.participants.hasAny([request.auth.uid])) ||\r\n        ('participants' in conversationData && conversationData.participants is map && request.auth.uid in conversationData.participants)\r\n      );\r\n    }\r\n\r\n    // User profiles - users can read their own profile. Admins have full control.\r\n    match /users/{userId} {\r\n      allow read: if isSignedIn() && (\r\n        request.auth.uid == userId ||\r\n        isAdmin() ||\r\n        ('role' in resource.data && resource.data.role == 'doctor')\r\n      );\r\n      allow create: if isSignedIn() && (\r\n        (request.auth.uid == userId && !('role' in request.resource.data))\r\n        || isAdmin()\r\n      );\r\n      allow update: if isAdmin()\r\n        || (isSignedIn() && request.auth.uid == userId && (\r\n             !('role' in request.resource.data)\r\n             || ('role' in resource.data && request.resource.data.role == resource.data.role)\r\n             || (!('role' in resource.data) && 'role' in request.resource.data)\r\n           ));\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    // Doctors collection\r\n    match /doctors/{doctorId} {\r\n      allow read: if isSignedIn();\r\n      allow create: if isDoctor() && request.auth.uid == doctorId;\r\n      allow update: if isDoctor() && request.auth.uid == doctorId;\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    // Patients collection\r\n    match /patients/{patientId} {\r\n      allow read: if isSignedIn();\r\n      allow create, update, delete: if isAdmin();\r\n    }\r\n\r\n    // Appointments collection\r\n    match /appointments/{appointmentId} {\r\n      allow create: if isSignedIn() && (\r\n        (isPatient() && request.resource.data.patientId == request.auth.uid) ||\r\n        (isDoctor() && request.resource.data.doctorId == request.auth.uid)\r\n      );\r\n      allow read: if isAdmin() || (isSignedIn() && isAppointmentParticipant(resource.data));\r\n      allow update: if isAdmin() || (\r\n        isSignedIn() &&\r\n        isAppointmentParticipant(resource.data) &&\r\n        isAppointmentParticipant(request.resource.data) &&\r\n        request.resource.data.patientId == resource.data.patientId &&\r\n        request.resource.data.doctorId == resource.data.doctorId\r\n      );\r\n      allow delete: if isAdmin() || (isSignedIn() && isAppointmentParticipant(resource.data));\r\n    }\r\n\r\n    // Doctor availability\r\n    match /availability/{doctorId}/dates/{dateId} {\r\n      allow create, update, delete: if isSignedIn() && request.auth.uid == doctorId;\r\n      allow read: if isSignedIn();\r\n    }\r\n\r\n    // Medical records\r\n    match /medicalRecords/{recordId} {\r\n      allow create: if isDoctor() &&\r\n        request.resource.data.doctorId == request.auth.uid;\r\n      allow read: if isSignedIn() && (\r\n        request.auth.uid == resource.data.patientId ||\r\n        request.auth.uid == resource.data.doctorId ||\r\n          (isDoctor() && exists(/databases/$(database)/documents/patients/$(resource.data.patientId))\r\n            && get(/databases/$(database)/documents/patients/$(resource.data.patientId)).data.assignedDoctorId == request.auth.uid)\r\n      );\r\n      allow update: if isDoctor() && request.auth.uid == resource.data.doctorId;\r\n      allow delete: if false;\r\n    }\r\n\r\n    // Conversations collection\r\n    match /conversations/{conversationId} {\r\n      allow read: if isAdmin() || (isSignedIn() && isConversationParticipant(resource.data));\r\n      // Corrected `list` rule for conversations (based on your successful local fix)\r\n      allow list: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.participants);\r\n      allow create: if isAdmin() || (isSignedIn() && isConversationParticipant(request.resource.data));\r\n      allow update: if isAdmin() || (isConversationParticipant(resource.data) && isConversationParticipant(request.resource.data) && (\r\n        (('participants' in resource.data) == ('participants' in request.resource.data)) && (\r\n          (!('participants' in resource.data)) || request.resource.data.participants == resource.data.participants\r\n        )\r\n      ));\r\n      allow delete: if isAdmin();\r\n\r\n      // Messages subcollection\r\n      match /messages/{messageId} {\r\n        // --- CRITICAL FIX HERE ---\r\n        // Allow read/list if admin OR user is a participant as specified in the message document itself.\r\n        // This avoids repeated `get()` calls to the parent conversation document.\r\n        allow read, list: if isAdmin() || (isSignedIn() && (\r\n          'conversationParticipants' in resource.data &&\r\n          resource.data.conversationParticipants is list &&\r\n          request.auth.uid in resource.data.conversationParticipants\r\n        ));\r\n\r\n        // Create: Admin OR user is a participant in the conversation (checked via message data) AND sender is current user\r\n        allow create: if isAdmin() || (\r\n          isSignedIn() &&\r\n          'conversationParticipants' in request.resource.data &&\r\n          request.resource.data.conversationParticipants is list &&\r\n          request.auth.uid in request.resource.data.conversationParticipants &&\r\n          request.resource.data.senderId == request.auth.uid\r\n        );\r\n\r\n        // Update: Only allow specific updates for read receipts. Forbid altering other fields.\r\n        allow update: if isAdmin() || (\r\n          isSignedIn() &&\r\n          'conversationParticipants' in resource.data &&\r\n          resource.data.conversationParticipants is list &&\r\n          request.auth.uid in resource.data.conversationParticipants &&\r\n          request.resource.data.senderId == resource.data.senderId &&\r\n          request.resource.data.text == resource.data.text &&\r\n          request.resource.data.type == resource.data.type &&\r\n          request.resource.data.createdAt == resource.data.createdAt &&\r\n          (\r\n            ('readBy' in resource.data && 'readBy' in request.resource.data && request.resource.data.readBy.size() >= resource.data.readBy.size()) ||\r\n            (!('readBy' in resource.data) && 'readBy' in request.resource.data)\r\n          )\r\n        );\r\n\r\n        // Delete: Admin can delete any message, or the sender can delete their own message\r\n        allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.senderId);\r\n      } // This closes the messages match block\r\n    } // This closes the conversations match block\r\n\r\n    // Fallback deny rule: Any unmatched document access is denied by default.\r\n    match /{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n  } // This closes the /databases/{database}/documents block\r\n} // This closes the service cloud.firestore block"}]}}
