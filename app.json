{
  "expo": {
    "name": "MediCare",
    "slug": "MediCare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.cooperlistic.medicare",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "medicare.ios.com",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "medicare.ios.com",
              "com.googleusercontent.apps.631948568273-4eifj85g1leh7kjqhmkhard0v3i45edm"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "medicare.ios.com",
              "com.googleusercontent.apps.631948568273-4eifj85g1leh7kjqhmkhard0v3i45edm"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.cooperlistic.MediCare"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "googleClientId": "631948568273-1600930e9qornkpk2p57q15agb20bvpc.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "f1571ba6-d691-416d-ad8c-5d029e9dfb2d"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
