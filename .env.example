# Copy this file to .env and fill in values as needed.
# NOTE: The React Native Firebase native SDKs usually auto-configure from:
# - android/google-services.json
# - iOS/GoogleService-Info.plist
# So these are OPTIONAL unless you want to override or run in environments without native config.

# --- Google Sign-In (optional) ---
EXPO_PUBLIC_WEB_CLIENT_ID=
EXPO_PUBLIC_ANDROID_CLIENT_ID=
EXPO_PUBLIC_IOS_CLIENT_ID=

# --- Firebase (optional JS fallback config) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
