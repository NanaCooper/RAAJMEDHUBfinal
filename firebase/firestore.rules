rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // Safely get the user's role using exists() to prevent crashes for new users
    function getUserRole() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data.role : '';
    }

    // Security: Whitelist specific admin emails
    function isAdminEmail() {
      return request.auth.token.email != null && request.auth.token.email.lower() in [
        'embidadzie@gmail.com',
        'raajctscan@gmail.com',
        'raajmedhub@gmail.com'
      ];
    }

    // Full Admin: Must have an admin role AND be on the email whitelist
    function isAdmin() {
      let role = getUserRole();
      return isSignedIn() && isAdminEmail() && role in [
        'admin', 'Admin', 'ADMIN', 'administrator',
        'reception', 'frontdesk', 'superadmin'
      ];
    }

    // Role-only check: Used for restricted creation flows (e.g. creating doctors)
    function isAdminByRole() {
      let role = getUserRole();
      return isSignedIn() && role in [
        'admin', 'Admin', 'ADMIN', 'administrator',
        'reception', 'frontdesk', 'superadmin',
        'admin_koforidua', 'admin_takoradi', 'admin_capecoast'
      ];
    }

    // Branch Admin: Must have a branch role AND be on the email whitelist
    function isBranchAdmin() {
      let role = getUserRole();
      return isSignedIn() && isAdminEmail() && role in [
        'admin_koforidua', 'admin_takoradi', 'admin_capecoast'
      ];
    }

    function isDoctor() {
      let role = getUserRole();
      return isSignedIn() && role in ['doctor', 'Doctor', 'DOCTOR'];
    }

    function isPatient() {
      let role = getUserRole();
      return isSignedIn() && role in ['patient', 'Patient', 'PATIENT'];
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAppointmentParticipant(appointmentData) {
      return isSignedIn() && (
        request.auth.uid == appointmentData.patientId || 
        request.auth.uid == appointmentData.doctorId ||
        ('patientEmail' in appointmentData && request.auth.token.email == appointmentData.patientEmail)
      );
    }

    function isConversationParticipant(conversationData) {
      return isSignedIn() && (
        request.auth.uid == conversationData.patientId || 
        request.auth.uid == conversationData.doctorId
      );
    }

    // Prevent users from escalating their own role after initial setup
    function isChangingProtectedField() {
      let protectedFields = ['role', 'department', 'organization', 'adminBranch'];
      let changed = protectedFields.hasAny(request.resource.data.diff(resource.data).affectedKeys());
      let noRoleYet = !('role' in resource.data) || resource.data.role == null || resource.data.role == '';
      return changed && !noRoleYet;
    }

    function getBranchForRole() {
      let r = getUserRole();
      return r == 'admin_koforidua' ? 'Koforidua'
           : r == 'admin_takoradi'  ? 'Takoradi'
           : r == 'admin_capecoast' ? 'Cape Coast'
           : '';
    }

    function isBranchMatch(appointmentData) {
      return appointmentData.branch == getBranchForRole();
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() || 
        isBranchAdmin() || 
        isDoctor() ||
        (resource.data.role in ['doctor', 'Doctor', 'DOCTOR'])
      );

      allow create: if isSignedIn() && (
        (request.auth.uid == userId && !('role' in request.resource.data))
        || isAdmin()
      );

      allow update: if isAdmin() || isBranchAdmin()
        || (isSignedIn() && request.auth.uid == userId);

      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /appointments/{appointmentId} {
      allow get: if isAdmin() || isBranchAdmin() ||
        (isDoctor() && resource.data.doctorId == request.auth.uid) ||
        (isSignedIn() && resource.data.patientId == request.auth.uid);
      allow list: if isAdmin() || isBranchAdmin() || isDoctor() || isPatient();
      
      allow create: if isSignedIn() && (
        isAdmin() ||
        isBranchAdmin() ||
        (isPatient() && request.resource.data.patientId == request.auth.uid) ||
        (isDoctor() && request.resource.data.doctorId == request.auth.uid)
      );

      allow update: if isAdmin() ||
        (isBranchAdmin() && isBranchMatch(resource.data)) ||
        (isSignedIn() &&
          isAppointmentParticipant(resource.data) &&
          request.resource.data.patientId == resource.data.patientId &&
          request.resource.data.doctorId == resource.data.doctorId
        );
      
      allow delete: if isAdmin();
    }

    match /doctors/{doctorId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isBranchAdmin() || isAdminByRole() || (isDoctor() && request.auth.uid == doctorId);
      allow update: if isAdmin() || isBranchAdmin() || (isDoctor() && request.auth.uid == doctorId);
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == doctorId);
    }

    match /patients/{patientId} {
      allow read: if isAdmin() || isBranchAdmin() || isDoctor() || request.auth.uid == patientId;
      allow create: if isAdmin() || isBranchAdmin() || isDoctor() || (isSignedIn() && patientId == request.auth.uid);
      allow update: if isAdmin() || isBranchAdmin() || isDoctor() || (isPatient() && patientId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == patientId);
    }

    match /procedures/{procedureId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.patientId ||
        isAdmin() ||
        isDoctor()
      );
      allow create, update: if isSignedIn() && (isAdmin() || isDoctor());
      allow delete: if isAdmin();
    }

    match /availability/{doctorId}/dates/{dateId} {
      allow create, update, delete: if isSignedIn() && request.auth.uid == doctorId;
      allow read: if isSignedIn();
    }

    match /medicalRecords/{recordId} {
      allow create: if isDoctor() && request.resource.data.doctorId == request.auth.uid;
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.patientId || 
        request.auth.uid == resource.data.doctorId ||
        (isDoctor() && exists(/databases/$(database)/documents/patients/$(resource.data.patientId))
            && get(/databases/$(database)/documents/patients/$(resource.data.patientId)).data.assignedDoctorId == request.auth.uid)
      );
      allow update: if isDoctor() && request.auth.uid == resource.data.doctorId;
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow create: if isSignedIn() && (
        request.resource.data.patientId == request.auth.uid ||
        (isDoctor() && request.resource.data.doctorId == request.auth.uid)
      );
      allow read: if isSignedIn() && isConversationParticipant(resource.data);

      match /messages/{messageId} {
        allow create: if isSignedIn() && 
          isConversationParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data) && 
          request.resource.data.senderId == request.auth.uid;
        allow read: if isSignedIn() && 
          isConversationParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow update, delete: if false;
      }
    }

    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /adminNotes/{noteId} {
      allow read: if isAdmin() || isBranchAdmin();
      allow create: if isDoctor();
      allow update, delete: if isAdmin();
    }

    match /doctorNotes/{noteId} {
      allow read: if isAdmin() || isBranchAdmin() ||
        (isDoctor() && (resource.data.doctorId == request.auth.uid || resource.data.senderId == request.auth.uid));
      allow create: if isDoctor();
      allow update: if isAdmin() || isBranchAdmin() || (isDoctor() && resource.data.senderId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /activity/{activityId} {
      allow read: if isAdmin() || isBranchAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
        match /referrals/{referralId} {
      allow read: if isAdmin() || isBranchAdmin() || (isDoctor() && resource.data.doctorId == request.auth.uid);
      allow create: if isAdmin() || isBranchAdmin() || (isDoctor() && request.resource.data.doctorId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}