rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions for common checks
    function isSignedIn() {
      return request.auth != null;
    }

    // Safely get the user's role, returning an empty string if not found.
    function getUserRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 'role' in userDoc.data)
        ? userDoc.data.role
        : '';
    }
    
    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }
    
    function isDoctor() {
      return isSignedIn() && getUserRole() == 'doctor';
    }
    
    function isPatient() {
      return isSignedIn() && getUserRole() == 'patient';
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAppointmentParticipant(appointmentData) {
      return isSignedIn() && (
        request.auth.uid == appointmentData.patientId || 
        request.auth.uid == appointmentData.doctorId ||
        ('patientEmail' in appointmentData && request.auth.token.email == appointmentData.patientEmail)
      );
    }

    function isConversationParticipant(conversationData) {
      return isSignedIn() && (
        request.auth.uid == conversationData.patientId || 
        request.auth.uid == conversationData.doctorId
      );
    }

    // User profiles - users can read their own profile. Admins have full control.
    // Clients may create their own user doc but MUST NOT include `role`. Admins may create with role.
    match /users/{userId} {
      // Read: owner, admin, doctor, OR any signed-in user reading a doc where role == 'doctor'
      // (allows patient-side calls like getDoctor to fall back to /users/ for doctor profiles)
      allow read: if isSignedIn() && (
        isOwner(userId) || 
        isAdmin() ||
        isDoctor() ||
        // Any signed-in user may read public doctor profiles
        (resource.data.role == 'doctor')
      );

      // Create: owner may create their doc but must not include `role`. Admins may create with role.
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && !('role' in request.resource.data))
        || isAdmin()
      );

      // Update: admins can fully update.
      // Owners can update their own profile, but cannot escalate role.
      // They may update other fields freely. Additionally, allow the owner to set
      // the `role` field once if the stored document does not already have a role
      // (this enables the user-type-selection flow where the user picks their role
      // immediately after signup). After a role exists, owners cannot change it.
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId && (
             // 1) Owner isn't attempting to modify the `role` field at all
             !('role' in request.resource.data)
             // OR 2) The stored resource already has a role and the update's role must match (no change)
             || ('role' in resource.data && request.resource.data.role == resource.data.role)
             // OR 3) The stored resource has no role yet and owner is setting it now (one-time set)
             || (!('role' in resource.data) && 'role' in request.resource.data)
           ));

      // Delete: admin only
      allow delete: if isAdmin();
    }

    // Appointments - only participants can read/write
    match /appointments/{appointmentId} {
      allow create: if isSignedIn() && (
        isAdmin() ||
        (isPatient() && request.resource.data.patientId == request.auth.uid && (!('doctorId' in request.resource.data) || request.resource.data.doctorId == null) && 'branch' in request.resource.data) ||
        (isDoctor() && request.resource.data.doctorId == request.auth.uid)
      );
      allow read: if isSignedIn() && (
        isAdmin() ||
        isAppointmentParticipant(resource.data)
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isAppointmentParticipant(resource.data) && 
        isAppointmentParticipant(request.resource.data) &&
        // Prevent changing patient/doctor IDs
        request.resource.data.patientId == resource.data.patientId &&
        request.resource.data.doctorId == resource.data.doctorId)
      );
      allow delete: if isSignedIn() && isAppointmentParticipant(resource.data);
    }

    // Doctors collection - doctors can read their own, patients can read all for browsing
    match /doctors/{doctorId} {
      allow read: if isSignedIn(); // All signed-in users can read doctor profiles
      allow create: if isSignedIn() && request.auth.uid == doctorId;
      allow update: if isSignedIn() && request.auth.uid == doctorId;
      allow delete: if isAdmin();
    }

    // Procedures / pricing catalogue - readable by all signed-in users, writable by admins only
    match /procedures/{procedureId} {
      // Price catalogue: safe to expose for browsing/search in-app.
      // Allow reads even when auth is still initializing to avoid permission-denied on app startup.
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Referrals (doctor payout tracking)
    match /referrals/{referralId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isDoctor() && resource.data.doctorId == request.auth.uid)
      );

      allow create: if isSignedIn() && (
        isAdmin() ||
        (isDoctor() && request.resource.data.doctorId == request.auth.uid)
      );

      // Keep edits restricted; payouts should be append-only from client.
      allow update, delete: if isAdmin();
    }

    // Scan reports - patients can read their own, admins/doctors can create and update
    match /reports/{reportId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.patientId ||
        isAdmin() ||
        isDoctor()
      );
      allow create, update: if isSignedIn() && (isAdmin() || isDoctor());
      allow delete: if isAdmin();
    }

    // Doctor availability - only the doctor can write, patients can read
    match /availability/{doctorId}/dates/{dateId} {
      allow create, update, delete: if isSignedIn() && request.auth.uid == doctorId;
      allow read: if isSignedIn();
    }

    // Medical records - strict access control
    match /medicalRecords/{recordId} {
      allow create: if isDoctor() && 
        request.resource.data.doctorId == request.auth.uid;
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.patientId || 
        request.auth.uid == resource.data.doctorId ||
          (isDoctor() && exists(/databases/$(database)/documents/patients/$(resource.data.patientId))
            && get(/databases/$(database)/documents/patients/$(resource.data.patientId)).data.assignedDoctorId == request.auth.uid)
      );
      allow update: if isDoctor() && request.auth.uid == resource.data.doctorId;
      allow delete: if false; // Medical records should never be deleted
    }

    // Messages in conversations
    match /conversations/{conversationId} {
      allow create: if isSignedIn() && (
        request.resource.data.patientId == request.auth.uid ||
        (isDoctor() && request.resource.data.doctorId == request.auth.uid)
      );
      allow read: if isSignedIn() && isConversationParticipant(resource.data);

      match /messages/{messageId} {
        allow create: if isSignedIn() && 
          isConversationParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data) && 
          request.resource.data.senderId == request.auth.uid;
        allow read: if isSignedIn() && 
          isConversationParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow update, delete: if false; // Messages can't be edited or deleted
      }
    }
  }
}